<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyFirstApp.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            
            <VerticalStackLayout Spacing="5">

                <Label
                    x:Name="HistoryScreen"
                    Text=""
                    FontSize="18"
                    HorizontalTextAlignment="End"
                    TextColor="Gray"/>

                <Label
                    x:Name="Screen"
                    Text="0"
                    FontSize="40"
                    HorizontalTextAlignment="End"/>

            </VerticalStackLayout>
            
            <Grid RowDefinitions="*,*,*,*"
                  ColumnDefinitions="*,*,*,*,*"
                  Padding="10"
                  ColumnSpacing="5"
                  RowSpacing="5">
                
                <Button Text="1" CommandParameter="1"
                        Grid.Row="0" Grid.Column="0"
                        Clicked="DigitClicked"/>

                <Button Text="2" CommandParameter="2"
                        Grid.Row="0" Grid.Column="1"
                        Clicked="DigitClicked"/>

                <Button Text="3" CommandParameter="3"
                        Grid.Row="0" Grid.Column="2"
                        Clicked="DigitClicked"/>

                <Button Text="+"
                        Grid.Row="0" Grid.Column="3"
                        Clicked="SumOperator_OnClicked"/>

                <Button Text="⌫"
                        Grid.Row="0" Grid.Column="4"
                        Clicked="Backspace_OnClicked"/>

            
                
                <Button Text="4" CommandParameter="4"
                        Grid.Row="1" Grid.Column="0"
                        Clicked="DigitClicked"/>

                <Button Text="5" CommandParameter="5"
                        Grid.Row="1" Grid.Column="1"
                        Clicked="DigitClicked"/>

                <Button Text="6" CommandParameter="6"
                        Grid.Row="1" Grid.Column="2"
                        Clicked="DigitClicked"/>

                <Button Text="-"
                        Grid.Row="1" Grid.Column="3"
                        Clicked="MinusOperator_OnClicked"/>

                <Button Text="%"
                        Grid.Row="1" Grid.Column="4"
                        Clicked="Percentage_OnClicked"/>

            
                
                <Button Text="7" CommandParameter="7"
                        Grid.Row="2" Grid.Column="0"
                        Clicked="DigitClicked"/>

                <Button Text="8" CommandParameter="8"
                        Grid.Row="2" Grid.Column="1"
                        Clicked="DigitClicked"/>

                <Button Text="9" CommandParameter="9"
                        Grid.Row="2" Grid.Column="2"
                        Clicked="DigitClicked"/>

                <Button Text="×"
                        Grid.Row="2" Grid.Column="3"
                        Clicked="MultiplyOperator_OnClicked"/>

                <Button Text="="
                        Grid.Row="2" Grid.Column="4"
                        Grid.RowSpan="2"
                        Clicked="EqualOperator_OnClicked"/>
            
            
            
                <Button Text="C"
                        Grid.Row="3" Grid.Column="0"
                        Clicked="Clear_OnClicked"/>
        
                
                <Button Text="0" CommandParameter="0"
                        Grid.Row="3" Grid.Column="1"
                        Clicked="DigitClicked"/>
        
                
                <Button Text="."
                        Grid.Row="3" Grid.Column="2"
                        Clicked="Decimal_OnClicked"/>
                
                <Button Text="÷"
                        Grid.Row="3" Grid.Column="3"
                        Clicked="DivisionOperator_OnClicked"/>

                </Grid>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
